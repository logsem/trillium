opam-version: "2.0"
name: "trillium"
version: "2.1.0"
synopsis: "Coq development of the Trillium framework"
maintainer: "Trillium Team"
authors: "Trillium Team"
license: "MIT"
build: ["./make-package" "trillium" "-j%{jobs}%"]
install: ["./make-package" "trillium" "install"]
depends: [
  "coq" { (= "9.0.0") }
  "coq-iris" { (= "4.3.0") }
  "coq-stdpp" { (="1.11.0") }
]